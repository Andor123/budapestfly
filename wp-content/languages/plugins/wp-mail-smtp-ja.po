msgstr "MailerSend アカウントが有料プランの場合に設定します。"

#: src/WPCLI/Options/Registry.php:519
msgid "MailerSend API key."
msgstr "MailerSend API キー。"

#: src/WPCLI/Options/Registry.php:497
msgid "Mailjet secret key."
msgstr "Mailjet シークレットキー。"

#: src/WPCLI/Options/Registry.php:490
msgid "Mailjet API key."
msgstr "Mailjet API キー。"

#: src/WPCLI/Options/Registry.php:468
msgid "SparkPost region (US or EU)."
msgstr "SparkPost の地域 (US または EU)。"

#: src/WPCLI/Options/Registry.php:462
msgid "SparkPost API key."
msgstr "SparkPost API キー。"

#: src/WPCLI/Options/Registry.php:440
msgid "SMTP2GO API key."
msgstr "SMTP2GO API キー。"

#: src/WPCLI/Options/Registry.php:418
msgid "SMTP.com sender channel name."
